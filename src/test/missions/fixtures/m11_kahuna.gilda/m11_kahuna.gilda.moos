ServerHost = localhost
ServerPort = 9002

// Community name IS the vehicle name
Community  = gilda
  
//----  Next Line was commented and replaced with a command line overload ---- //
//MOOSTimeWarp = 4    (default)
MOOSTimeWarp = 4
LatOrigin  = 43.825300 
LongOrigin = -70.330400 


//--------------------------------------------------------
// uTimerScript Configuration Block

ProcessConfig = uTimerScript
{
  AppTick   = 4
  CommsTick = 4
  
  PAUSED     = false
  RESET_MAX  = unlimited
  RESET_TIME = 100

  RANDVAR = varname=S, min=1,  max=3, key=at_reset
  
//  EVENT = var=NODE_MESSAGE_LOCAL, val="src_node=gilda,dest_node=all,var_name=GILDA_UPDATES,string_val=speed=$[S]", time=0:5 
  EVENT = var=GILDA_UPDATES, val="speed=$[S]", time=0:5 
}


 


   
//------------------------------------------------------------
ProcessConfig = ANTLER
{
  Run = uTimerScript @ NewConsole = false ~ uTimerScript_record
  MSBetweenLaunches = 100
   
  Run = MOOSDB            @ NewConsole = false
  Run = pLogger @ NewConsole = false
  Run = uSimMarineV22     @ NewConsole = false
  Run = pNodeReporter     @ NewConsole = false
  Run = pMarinePIDV22     @ NewConsole = false
  Run = pHelmIvP          @ NewConsole = false
  Run = uProcessWatch     @ NewConsole = false

  Run = pShare             @ NewConsole = false
  Run = pHostInfo          @ NewConsole = false
  Run = uFldNodeBroker     @ NewConsole = false
  Run = uFldMessageHandler @ NewConsole = false
  Run = uTimerScript       @ NewConsole = false
}

//---------------------------------------------------------
// pShare Config Block  (Created from Plugin)

ProcessConfig = pShare
{
  AppTick    = 2
  CommsTick  = 2

  input = route =  localhost:9302

  // =======================================================
  // Usage Info below
