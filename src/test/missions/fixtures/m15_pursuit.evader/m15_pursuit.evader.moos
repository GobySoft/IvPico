ProcessConfig = uTimerScript_record
{
  condition = (IVPHELM_STATE = PARK) or (IVPHELM_STATE = DRIVE)
  event = var=DEPLOY, val=true, time=5
  event = var=MOOS_MANUAL_OVERRIDE, val=false, time=5
}


