ServerHost   = localhost
ServerPort   = 9000
Community    = echo
//----  Next Line was commented and replaced with a command line overload ---- //
//MOOSTimeWarp = 1    (default)
MOOSTimeWarp = 10

LatOrigin  = 43.825300 
LongOrigin = -70.330400 

//------------------------------------------
// Antler configuration  block

ProcessConfig = ANTLER
{
  Run = uTimerScript @ NewConsole = false ~ uTimerScript_record
  MSBetweenLaunches = 200

  Run = MOOSDB          @ NewConsole = false
  Run = pLogger @ NewConsole = false
  Run = uSimMarine      @ NewConsole = false
  Run = pNodeReporter   @ NewConsole = false
  Run = pMarinePID      @ NewConsole = false
  Run = pMarineViewer   @ NewConsole = false
  Run = pHelmIvP        @ NewConsole = false
  Run = uTimerScript    @ NewConsole = false
  Run = uXMS            @ NewConsole = false
  Run = uMemWatch       @ NewConsole = false
}

//------------------------------------------
// uXMS config block

ProcessConfig = uXMS
{
  AppTick   = 4
  CommsTick = 4
  
  var = IVPHELM_ITER
  var = IVPHELM_DOMAIN
  var = IVPHELM_BHV_CNT
  var = IVPHELM_BHV_CNT_EVER
  var = IVPHELM_ALLSTOP
  var = IVPHELM_STATE
}

//------------------------------------------
// uMemWatch config block

ProcessConfig = uMemWatch                                       
{                                                               
  AppTick   = 4                                                 
  CommsTick = 4                                                 
                                                                
  absolute_time_gap = 1   // In Seconds, Default is 1.          
                                                                
  watch_only = pHelmIvP,pMarineViewer
}                                  


//------------------------------------------
// pLogger config block

